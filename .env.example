# SECRET PROJECT KEY (ACCESS KEY FOR ALL SOFTWARE, DON'T SHARE)
AI_SECRET_KEY='YOUR_SECRET_KEY'

# GEMINI CONFIG
GEMINI_API_KEY='YOUR_API_KEY'
GEMINI_MODEL_NAME='YOUR_MODEL'

# POSTGRES CONFIG
PG_USERNAME='YOUR_USERNAME'
PG_PASSWORD='YOUR_PASSWORD' 
PG_DBNAME='YOUR_DBNAME'

PG_CONNECTIONSTRING_MODEL='postgresql+psycopg://[PG_USERNAME]:[PG_PASSWORD]@[DB_SERVER]:[DB_PORT]/[DB_NAME]'

# FLAGS

# Turn ON or OFF the database instance
USE_DATABASE=<true or false> 